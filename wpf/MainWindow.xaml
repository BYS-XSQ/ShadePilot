<Window x:Class="ShadePilotWpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ShadePilot WPF Preview" Width="1180" Height="840" MinWidth="1000" MinHeight="700" WindowStyle="None" ResizeMode="CanResize"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="False">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F8F5EF"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/><SolidColorBrush x:Key="Tint" Color="#FCF7EE"/>
  <SolidColorBrush x:Key="Soft" Color="#F8F4EC"/><SolidColorBrush x:Key="Accent" Color="#C9824D"/><SolidColorBrush x:Key="AccentSoft" Color="#F7E7D8"/>
  <SolidColorBrush x:Key="Text" Color="#392C24"/><SolidColorBrush x:Key="Muted" Color="#8B7667"/><SolidColorBrush x:Key="Border" Color="#DDD4CB"/>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".86"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="B" CornerRadius="8" Padding="14,12" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse x:Name="D" Width="7" Height="7" Fill="{DynamicResource Border}"/><ContentPresenter Grid.Column="1" Margin="11,0,0,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="D" Property="Fill" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="Background" Value="{DynamicResource Soft}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="TextBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style><Style TargetType="ListBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style><Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,4,18,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
 </Window.Resources>
 <Grid Background="{DynamicResource Canvas}"><Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="25,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Image Source="../assets/shadepilot-icon.ico" Width="56" Height="56" Margin="0,0,15,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="ShadePilot" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="明暗与色彩控制台" FontSize="11.5"/><TextBlock Text="DISPLAY INTELLIGENCE · COLOR CONTROL" FontFamily="Segoe UI" FontSize="9.5" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="14" Padding="14,7" Margin="0,0,8,0"><TextBlock Text="WPF 迁移版" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Border><Button Style="{StaticResource WindowButton}" Content="−" Click="Minimize_Click"/><Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource WindowButton}" Content="×" Click="Close_Click"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="18,22"><DockPanel><Border DockPanel.Dock="Bottom" Background="{DynamicResource Tint}" CornerRadius="8" Padding="12"><TextBlock Text="外部显示控制&#x0a;不注入游戏 · 不叠加画面" Foreground="{DynamicResource Muted}" FontSize="10.5"/></Border><StackPanel><TextBlock Text="功能板块" Foreground="{DynamicResource Muted}" Margin="8,0,0,8"/><RadioButton x:Name="DisplayNav" Style="{StaticResource Nav}" Content="显示控制" IsChecked="True" Checked="Nav_Checked" Tag="Display"/><RadioButton Style="{StaticResource Nav}" Content="画面风格" Checked="Nav_Checked" Tag="Style"/><RadioButton Style="{StaticResource Nav}" Content="准星" Checked="Nav_Checked" Tag="Crosshair"/><RadioButton Style="{StaticResource Nav}" Content="工具中心" Checked="Nav_Checked" Tag="Tools"/></StackPanel></DockPanel></Border>
   <Grid Grid.Column="1" Margin="26,22,24,20">
    <ScrollViewer x:Name="DisplayPage" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="显示控制" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="显示器硬件参数与多屏同步设置" Foreground="{DynamicResource Muted}" Margin="0,5,0,16"/><Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="显示器" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="MonitorBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="MonitorBox_SelectionChanged"/><Button Grid.Column="2" Content="重新检测" Margin="12,0,0,0" Click="Refresh_Click"/></Grid><TextBlock Text="亮度" FontWeight="SemiBold" Margin="0,18,0,0"/><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" ValueChanged="HardwareSlider_ValueChanged"/><TextBlock Text="对比度" FontWeight="SemiBold" Margin="0,16,0,0"/><Slider x:Name="ContrastSlider" Minimum="0" Maximum="100" ValueChanged="HardwareSlider_ValueChanged"/><TextBlock Text="饱和度" FontWeight="SemiBold" Margin="0,16,0,0"/><Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" ValueChanged="HardwareSlider_ValueChanged"/><DockPanel Margin="0,18,0,0"><Button DockPanel.Dock="Right" Content="应用全部" Click="ApplyHardware_Click"/><CheckBox x:Name="LiveApply" Content="拖动时实时应用" IsChecked="True"/><CheckBox Content="同步所有显示器画面风格"/></DockPanel><TextBlock x:Name="DisplayStatus" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="StylePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="画面风格" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="预设、明暗曲线与色彩参数微调" Foreground="{DynamicResource Muted}" Margin="0,5,0,16"/><Border Style="{StaticResource Card}" Background="{DynamicResource Tint}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="应用风格" Click="ApplyStyle_Click"/><ComboBox x:Name="PresetBox" Width="320" HorizontalAlignment="Left" SelectionChanged="PresetBox_SelectionChanged"/></DockPanel><UniformGrid Columns="3" Margin="0,12,0,0"><StackPanel Margin="7"><TextBlock Text="提亮暗部"/><Slider x:Name="Shadows" Maximum="200"/></StackPanel><StackPanel Margin="7"><TextBlock Text="压低高光"/><Slider x:Name="Highlights" Maximum="200"/></StackPanel><StackPanel Margin="7"><TextBlock Text="中间调"/><Slider x:Name="Midtones" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="黑位"/><Slider x:Name="BlackPoint" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="白位"/><Slider x:Name="WhitePoint" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="中间对比"/><Slider x:Name="ContrastPivot" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="色温"/><Slider x:Name="Temperature" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="色调"/><Slider x:Name="TintSlider" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="自然色彩"/><Slider x:Name="Vibrance" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="整体曝光"/><Slider x:Name="Exposure" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="暗部范围"/><Slider x:Name="ShadowRange" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="高光范围"/><Slider x:Name="HighlightRange" Minimum="-100" Maximum="100"/></StackPanel><StackPanel Margin="7"><TextBlock Text="过渡柔和"/><Slider x:Name="Softness" Minimum="-100" Maximum="100"/></StackPanel></UniformGrid><TextBlock x:Name="StyleStatus" Foreground="{DynamicResource Muted}" Margin="7,12,7,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="工具中心" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="自动切换、恢复策略与迁移状态" Foreground="{DynamicResource Muted}" Margin="0,5,0,16"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="游戏自动切换" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><CheckBox x:Name="AutoSwitch" Content="启用前台游戏自动切换"/><CheckBox x:Name="RestoreAfterGame" Content="离开游戏后恢复进入前画面"/><CheckBox x:Name="FrameProtection" Content="游戏性能保护"/></WrapPanel><TextBlock Text="退出时始终恢复本次启动前的显示状态；异常退出将在下次启动自动恢复。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Background="{DynamicResource Tint}"><StackPanel><TextBlock Text="迁移状态" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="WPF 主窗口、显示器硬件控制、预设读取与 Gamma 风格应用已接入。全局快捷键、托盘、A/B 对比、分享代码和自动切换后台逻辑将在下一阶段接入；当前不会替换稳定版。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="24" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>

    <Grid x:Name="CrosshairPage" Visibility="Collapsed">
     <ScrollViewer x:Name="CrosshairBasicScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,0,16">
       <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="准星" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="自定义并快速切换屏幕准星。" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="LegacyCrosshairRuntimeStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="16,0,0,0"/></DockPanel>
       <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="LegacyCrosshairEnabled" Content="开启准星" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,28,0"/><TextBlock Text="目标显示器" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="LegacyCrosshairMonitorBox" Grid.Column="2" Width="220" HorizontalAlignment="Left"/></Grid></Border>
       <Grid x:Name="CrosshairBasicLayout" MinWidth="760"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,12,16" Padding="16">
         <StackPanel>
          <DockPanel><Button x:Name="LegacyCrosshairNewButton" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Content="+ 新建" Click="CrosshairNew_Click" Width="84" Height="34"/><StackPanel><TextBlock Text="我的准星" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="LegacyCrosshairCycleCount" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel>
          <Grid Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="轮换" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="预设" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="11"/></Grid>
          <ListBox x:Name="CrosshairPresetList" Height="300" SelectionChanged="CrosshairPresetList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox Grid.Column="0" IsChecked="{Binding IncludeInCycle, Mode=TwoWay}" ToolTip="勾选 = 参与快捷轮换" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <StackPanel Margin="0,12,0,0"><TextBlock Text="轮换" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="LegacyCrosshairCycleOrder" Text="暂无参与轮换的预设" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/><TextBlock Text="勾选参与快捷轮换 · 按列表顺序循环" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/></StackPanel>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CrosshairEditPresetButton" Style="{StaticResource Secondary}" Content="编辑" Click="CrosshairEditPreset_Click" Height="34" Padding="6,6"/><Button x:Name="LegacyCrosshairDuplicatePresetButton" Style="{StaticResource Secondary}" Content="复制" Click="CrosshairDuplicatePreset_Click" Grid.Column="2" Height="34" Padding="6,6"/><Button x:Name="LegacyCrosshairRenamePresetButton" Style="{StaticResource Secondary}" Content="重命名" Click="CrosshairRenamePreset_Click" Grid.Column="4" Height="34" Padding="6,6"/><Button x:Name="LegacyCrosshairDeletePresetButton" Style="{StaticResource Secondary}" Content="删除" Click="CrosshairDeletePreset_Click" Grid.Column="6" Height="34" Padding="6,6"/></Grid>
          <TextBlock Text="* 表示当前有未保存修改" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" FontSize="11"/>
          <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0">
           <StackPanel>
            <TextBlock Text="快捷键" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid Height="36" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="显示 / 隐藏" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="LegacyCrosshairToggleHotkey" Grid.Column="2" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/></Grid>
            <Grid Height="36" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="下一个准星" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="LegacyCrosshairNextHotkey" Grid.Column="2" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/></Grid>
            <Grid Height="36"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="上一个准星" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBox x:Name="LegacyCrosshairPreviousHotkey" Grid.Column="2" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/></Grid>
           </StackPanel>
          </Border>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="0,0,0,16" Padding="20">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CrosshairPresetName" Text="当前准星" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="参数修改会实时显示，保存用于记住当前设置。" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><Button x:Name="CrosshairSaveButton" Content="保存修改" Click="CrosshairSave_Click" Grid.Column="1" Width="120" Height="36" Margin="16,0,0,0"/></Grid>
          <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="直接切换到此预设" VerticalAlignment="Center"/><TextBox x:Name="LegacyCrosshairPresetHotkey" Grid.Column="1" IsReadOnly="True" TextAlignment="Center" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/></Grid>
          <TextBlock x:Name="BasicTemplateHint" Text="" Foreground="{DynamicResource Muted}" Margin="0,12,0,8" TextWrapping="Wrap" LineHeight="20"/>
          <TextBlock Text="颜色" FontWeight="SemiBold"/><TextBox x:Name="BasicColor" Width="108" HorizontalAlignment="Left" Margin="0,8,0,12"/>
          <TextBlock Text="透明度" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><TextBox x:Name="BasicOpacityValue" Width="68" Margin="8,0,0,0" DockPanel.Dock="Right" TextAlignment="Center"/><Slider x:Name="BasicOpacity" Minimum="0" Maximum="100" HorizontalAlignment="Stretch"/></DockPanel>
          <TextBlock Text="整体大小" FontWeight="SemiBold" Margin="0,16,0,0"/><DockPanel Margin="0,8,0,0"><TextBox x:Name="CrosshairGlobalScaleValue" Width="68" Margin="8,0,0,0" DockPanel.Dock="Right" TextAlignment="Center" VerticalContentAlignment="Center"/><Slider x:Name="CrosshairGlobalScaleSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.01" LargeChange="0.1" ToolTip="调整实际屏幕准星的整体大小"/></DockPanel>
          <StackPanel x:Name="BasicDotFields" Margin="0,16,0,0"><TextBlock Text="大小" FontWeight="SemiBold"/><DockPanel><Slider x:Name="BasicSize" Minimum="1" Maximum="128"/><TextBox x:Name="BasicSizeValue" Width="68" Margin="8,0,0,0"/></DockPanel><CheckBox x:Name="BasicOutline" Content="轮廓"/><TextBlock Text="轮廓粗细"/><Slider x:Name="BasicOutlineThickness" Minimum="0" Maximum="20"/></StackPanel>
          <StackPanel x:Name="BasicCrossFields" Margin="0,16,0,0"><TextBlock Text="长度" FontWeight="SemiBold"/><Slider x:Name="BasicCrossLength" Minimum="1" Maximum="80"/><TextBlock Text="粗细" Margin="0,8,0,0"/><Slider x:Name="BasicThickness" Minimum="1" Maximum="20"/><TextBlock Text="间距" Margin="0,8,0,0"/><Slider x:Name="BasicGap" Minimum="0" Maximum="40"/><WrapPanel><CheckBox x:Name="BasicCenterPoint" Content="中心点"/><CheckBox x:Name="BasicCrossOutline" Content="轮廓"/></WrapPanel><TextBlock Text="中心点大小"/><Slider x:Name="BasicCenterSize" Minimum="1" Maximum="32"/><TextBlock Text="轮廓粗细"/><Slider x:Name="BasicCrossOutlineThickness" Minimum="0" Maximum="20"/></StackPanel>
          <StackPanel x:Name="BasicRingFields" Margin="0,16,0,0"><TextBlock Text="直径" FontWeight="SemiBold"/><Slider x:Name="BasicRingDiameter" Minimum="2" Maximum="180"/><TextBlock Text="线宽" Margin="0,8,0,0"/><Slider x:Name="BasicRingThickness" Minimum="1" Maximum="20"/></StackPanel>
          <StackPanel x:Name="BasicChevronFields" Margin="0,16,0,0"><TextBlock Text="长度" FontWeight="SemiBold"/><Slider x:Name="BasicChevronLength" Minimum="1" Maximum="100"/><TextBlock Text="夹角" Margin="0,8,0,0"/><Slider x:Name="BasicAngle" Minimum="10" Maximum="80"/><TextBlock Text="粗细" Margin="0,8,0,0"/><Slider x:Name="BasicChevronThickness" Minimum="1" Maximum="20"/></StackPanel>
          <TextBlock Text="位置" FontWeight="SemiBold" Margin="0,16,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LegacyCrosshairPositionSummary" Text="X 0 · Y 0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LegacyCrosshairAdjustPositionButton" Content="调整位置" Click="CrosshairAdjustPosition_Click" Width="110" Height="34"/><Button x:Name="LegacyCrosshairResetPositionButton" Style="{StaticResource Secondary}" Content="重置居中" Click="CrosshairResetPosition_Click" Width="100" Height="34" Margin="8,0,0,0"/><Button x:Name="LegacyCrosshairCancelPositionButton" Style="{StaticResource Secondary}" Content="取消" Click="CrosshairCancelPosition_Click" Visibility="Collapsed" Width="76" Height="34" Margin="8,0,0,0"/></StackPanel></Grid>
          <TextBlock x:Name="LegacyCrosshairPositionEditHint" Text="" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
          <Expander x:Name="CrosshairMoreSettings" Header="更多设置" Margin="0,16,0,0"><StackPanel><TextBlock Text="精确位置" FontWeight="SemiBold" Margin="0,8,0,8"/><WrapPanel><StackPanel><TextBlock Text="X"/><TextBox x:Name="LegacyCrosshairOffsetX" Width="100"/></StackPanel><StackPanel Margin="12,0,0,0"><TextBlock Text="Y"/><TextBox x:Name="LegacyCrosshairOffsetY" Width="100"/></StackPanel></WrapPanel><TextBlock Text="这里用于精确输入屏幕位置；日常调整可直接使用上方按钮。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,4"/><Button x:Name="CrosshairEditStructureButton" Content="编辑单个元素" Click="CrosshairAdvancedMode_Click" Margin="0,12,0,0"/></StackPanel></Expander>
         </StackPanel>
        </Border>
       </Grid>
       <StackPanel Visibility="Collapsed"><ComboBox x:Name="LegacyCrosshairPresetBox"/><ComboBox x:Name="CrosshairTemplateBox"/><CheckBox x:Name="LegacyCrosshairIncludeCycle"/></StackPanel>
      </StackPanel>
     </ScrollViewer>

     <ScrollViewer x:Name="CrosshairAdvancedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
      <Grid x:Name="CrosshairAdvancedLayout" Visibility="Visible" Margin="0,0,0,16" MinWidth="840">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,16">
        <DockPanel Margin="0,0,0,16"><StackPanel><TextBlock Text="准星自定义" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选择预设后直接编辑组成元素。" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="CrosshairRuntimeStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="16,0,0,0"/></DockPanel>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="CrosshairEnabled" Content="开启准星" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,28,0"/><TextBlock Text="目标显示器" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="CrosshairMonitorBox" Grid.Column="2"/><TextBlock Grid.Column="3" Text="外部显示控制，不注入游戏。修改后点击保存。" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="当前预设" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="CrosshairPresetBox" Grid.Column="1"/><CheckBox x:Name="CrosshairIncludeCycle" Grid.Column="2" Content="参与轮换" VerticalAlignment="Center" Margin="16,0"/><TextBox x:Name="CrosshairPresetHotkey" Grid.Column="3" IsReadOnly="True" TextAlignment="Center" ToolTip="点击后按下此预设的切换快捷键" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/><StackPanel Grid.Column="5" Orientation="Horizontal"><Button x:Name="CrosshairNewButton" Style="{StaticResource Secondary}" Content="+ 新建" Click="CrosshairNew_Click" Width="76" Height="34"/><Button x:Name="CrosshairDuplicatePresetButton" Style="{StaticResource Secondary}" Content="复制" Click="CrosshairDuplicatePreset_Click" Width="62" Height="34" Margin="6,0,0,0"/><Button x:Name="CrosshairRenamePresetButton" Style="{StaticResource Secondary}" Content="重命名" Click="CrosshairRenamePreset_Click" Width="70" Height="34" Margin="6,0,0,0"/><Button x:Name="CrosshairDeletePresetButton" Style="{StaticResource Secondary}" Content="删除" Click="CrosshairDeletePreset_Click" Width="62" Height="34" Margin="6,0,0,0"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="显示 / 隐藏" VerticalAlignment="Center"/><TextBox x:Name="CrosshairToggleHotkey" Grid.Column="1" Margin="10,0,20,0" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/><TextBlock Grid.Column="2" Text="下一个" VerticalAlignment="Center"/><TextBox x:Name="CrosshairNextHotkey" Grid.Column="3" Margin="10,0,20,0" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/><TextBlock Grid.Column="4" Text="上一个" VerticalAlignment="Center"/><TextBox x:Name="CrosshairPreviousHotkey" Grid.Column="5" Margin="10,0,20,0" TextAlignment="Center" IsReadOnly="True" PreviewKeyDown="CrosshairHotkey_PreviewKeyDown"/><StackPanel Grid.Column="6"><TextBlock x:Name="CrosshairCycleCount" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="CrosshairCycleOrder" Text="暂无参与轮换的预设" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"/></StackPanel></Grid></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CrosshairAdvancedBackButton" Content="取消新建" Click="CrosshairBasicMode_Click" Style="{StaticResource Secondary}" Width="110" Height="36" HorizontalAlignment="Left" Visibility="Collapsed"/><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="CrosshairAdvancedHeaderTitle" Text="自定义准星" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="CrosshairAdvancedPresetTitle" Text="当前准星" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CrosshairAdvancedResetButton" Content="重置修改" Click="CrosshairAdvancedReset_Click" Style="{StaticResource Secondary}" Width="100" Height="36" Margin="0,0,8,0"/><Button x:Name="CrosshairAdvancedSaveButton" Content="保存修改" Click="CrosshairSave_Click" Width="120" Height="36"/></StackPanel></Grid>
       </StackPanel>
        <Grid x:Name="CrosshairCreateSettingsPanel" Grid.Row="1" Visibility="Visible" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="260"/><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="准星名称" VerticalAlignment="Center"/><TextBox x:Name="CrosshairCreateName" Grid.Column="1" Height="38" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="11,0" TextChanged="CrosshairCreateName_TextChanged"/><TextBlock Grid.Column="2" Text="结构来源" VerticalAlignment="Center" Margin="20,0,0,0"/><ComboBox x:Name="CrosshairCreateTemplateBox" Grid.Column="3" Height="38" SelectionChanged="CrosshairCreateTemplate_SelectionChanged"/></Grid>
        <Grid Grid.Row="2">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" Padding="14"><StackPanel><DockPanel><TextBlock Text="图层 / 元素" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CrosshairAddButton" Content="+ 添加" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Click="CrosshairAddMenu_Click" Width="68" Height="34" Margin="8,0,0,0"/></DockPanel><Popup x:Name="CrosshairAddPopover" PlacementTarget="{Binding ElementName=CrosshairAddButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Style="{StaticResource Card}" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="添加元素" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,0,2,8"/><Button Style="{StaticResource Secondary}" Content="线" Click="CrosshairAddLine_Click" Height="32" Margin="0,2"/><Button Style="{StaticResource Secondary}" Content="点" Click="CrosshairAddDot_Click" Height="32" Margin="0,2"/><Button Style="{StaticResource Secondary}" Content="圆环" Click="CrosshairAddRing_Click" Height="32" Margin="0,2"/><Button Style="{StaticResource Secondary}" Content="矩形" Click="CrosshairAddRect_Click" Height="32" Margin="0,2"/><Button Style="{StaticResource Secondary}" Content="PNG 图片" Click="CrosshairImportPng_Click" Height="32" Margin="0,2"/></StackPanel></Border></Popup><ListBox x:Name="CrosshairElements" Height="310" Margin="0,12,0,12"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Value.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="5,2" Margin="6,0,0,0"><TextBlock Text="{Binding Value.Kind}" FontSize="10" Foreground="{DynamicResource Accent}"/></Border></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Style="{StaticResource Secondary}" Content="复制" Click="CrosshairDuplicate_Click" Height="34" Margin="0,0,8,0"/><Button Style="{StaticResource Secondary}" Content="删除" Click="CrosshairDelete_Click" Height="34"/></WrapPanel></StackPanel></Border>
         <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1" Background="{DynamicResource Tint}" Margin="0" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="300"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="结构预览" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><WrapPanel Grid.Row="1" Margin="0,10,0,0"><TextBlock Text="背景" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="CrosshairAdvancedPreviewBackgroundBox" Width="72" Height="34"/><TextBlock Text="缩放" VerticalAlignment="Center" Margin="12,0,6,0"/><Slider x:Name="CrosshairAdvancedPreviewZoomSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.05" LargeChange="0.1" Width="120" VerticalAlignment="Center" ValueChanged="CrosshairAdvancedPreviewZoomSlider_ValueChanged"/><TextBox x:Name="CrosshairAdvancedPreviewZoomValue" Width="62" Height="32" Margin="6,0,0,0" Padding="4,2" TextAlignment="Center" VerticalContentAlignment="Center" LostFocus="CrosshairAdvancedPreviewZoomValue_LostFocus" PreviewKeyDown="CrosshairAdvancedPreviewZoomValue_PreviewKeyDown"/><Button Content="100%" Style="{StaticResource Secondary}" Width="52" Height="32" Margin="6,0,0,0" Padding="6,4" Click="CrosshairAdvancedPreviewZoomReset_Click"/></WrapPanel><Border x:Name="CrosshairAdvancedPreviewBackdrop" Grid.Row="2" Background="#252A36" CornerRadius="10" Margin="0,12,0,12"><Canvas x:Name="CrosshairAdvancedPreviewCanvas" Background="Transparent" PreviewMouseWheel="CrosshairAdvancedPreviewCanvas_PreviewMouseWheel"/></Border><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="CrosshairAdvancedPreviewGuide" Content="中心辅助线" Margin="0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="拖动元素调整位置" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid></Border>
         <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="16">
          <StackPanel>
           <TextBlock Text="元素属性" FontSize="16" FontWeight="SemiBold"/>
           <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
             <TextBlock Text="基础" FontWeight="SemiBold" Margin="0,0,0,8"/>
             <TextBlock Text="元素名称" Foreground="{DynamicResource Muted}" FontSize="11"/>
             <TextBox x:Name="CrosshairElementName" Height="36" Margin="0,4,0,8"/>
             <TextBlock Text="类型" Foreground="{DynamicResource Muted}" FontSize="11"/>
             <TextBox x:Name="CrosshairElementKind" IsReadOnly="True" Height="36" Background="{DynamicResource AccentSoft}" BorderThickness="0" Margin="0,4,0,8"/>
             <CheckBox x:Name="CrosshairElementEnabled" Content="显示此元素" Margin="0,0,0,4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
             <TextBlock Text="大小" FontWeight="SemiBold" Margin="0,0,0,8"/>
             <TextBlock Text="整体大小" Foreground="{DynamicResource Muted}" FontSize="11" ToolTip="改变实际屏幕准星的整体尺寸。"/>
             <DockPanel Margin="0,4,0,12"><TextBox x:Name="CrosshairEditorGlobalScaleValue" Width="68" Margin="8,0,0,0" DockPanel.Dock="Right" TextAlignment="Center" VerticalContentAlignment="Center"/><Slider x:Name="CrosshairEditorGlobalScaleSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.01" LargeChange="0.1"/></DockPanel>
             <TextBlock Text="单元素大小" Foreground="{DynamicResource Muted}" FontSize="11"/>
             <DockPanel Margin="0,4,0,0"><TextBox x:Name="CrosshairElementScaleValue" Width="68" Margin="8,0,0,0" DockPanel.Dock="Right" TextAlignment="Center" VerticalContentAlignment="Center"/><Slider x:Name="CrosshairElementScaleSlider" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.01" LargeChange="0.1"/></DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="4">
             <TextBlock Text="位置与变换" FontWeight="SemiBold" Margin="0,0,0,8"/>
             <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="CrosshairX" Height="36"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="CrosshairY" Height="36"/></StackPanel></Grid>
             <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="旋转" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="CrosshairRotation" Height="36"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="不透明度" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="CrosshairOpacity" Height="36"/></StackPanel></Grid>
            </StackPanel>
            <StackPanel Grid.Column="6">
             <TextBlock Text="外观" FontWeight="SemiBold" Margin="0,0,0,8"/>
             <TextBlock Text="颜色" Foreground="{DynamicResource Muted}" FontSize="11"/>
             <TextBox x:Name="CrosshairColor" Width="108" HorizontalAlignment="Left" Margin="0,4,0,10"/>
             <TextBlock Text="镜像" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,4"/>
             <WrapPanel><CheckBox x:Name="CrosshairMirrorX" Content="水平" Margin="0,4,24,4"/><CheckBox x:Name="CrosshairMirrorY" Content="垂直" Margin="0,4,0,0"/></WrapPanel>
            </StackPanel>
           </Grid>
           <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
             <StackPanel><TextBlock Text="屏幕位置" FontWeight="SemiBold"/><TextBlock x:Name="CrosshairPositionSummary" Text="X 0 · Y 0" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
             <WrapPanel Grid.Column="1"><Button x:Name="CrosshairAdjustPositionButton" Content="调整位置" Click="CrosshairAdjustPosition_Click" Width="96" Height="34"/><Button x:Name="CrosshairResetPositionButton" Style="{StaticResource Secondary}" Content="居中" Click="CrosshairResetPosition_Click" Width="66" Height="34" Margin="8,0,0,0"/><Button x:Name="CrosshairCancelPositionButton" Style="{StaticResource Secondary}" Content="取消" Click="CrosshairCancelPosition_Click" Visibility="Collapsed" Width="62" Height="34" Margin="8,0,0,0"/></WrapPanel>
             <TextBlock x:Name="CrosshairPositionEditHint" Grid.Column="2" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="16,0" Visibility="Collapsed" VerticalAlignment="Center"/>
             <StackPanel Grid.Column="3"><TextBlock Text="屏幕 X" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBox x:Name="CrosshairOffsetX" Height="34" Margin="0,4,0,0"/></StackPanel>
             <StackPanel Grid.Column="5"><TextBlock Text="屏幕 Y" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBox x:Name="CrosshairOffsetY" Height="34" Margin="0,4,0,0"/></StackPanel>
            </Grid>
           </Border>
          </StackPanel>
         </Border>
       </Grid>
      </Grid>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><DockPanel Margin="24,7"><TextBlock Text="BY XD · 免费分享，倒卖必究" Foreground="{DynamicResource Accent}"/><TextBlock DockPanel.Dock="Right" Text="ShadePilot WPF migration preview" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
 </Grid>
